generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")  
}

model User {
  id            Int     @id @default(autoincrement())
  name          String
  email         String  @unique
  password      String
  role          String  @default("ADMIN") 
  resetToken    String?
  refreshToken  String?
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Store {
  id            Int     @id @default(autoincrement())
  storeName     String
  location      String?
  email         String  @unique
  password      String
  role          String  @default("STORE")
  refreshToken  String?
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
  brands        Brand[]
  categories    Category[] 
  metals        Metal[]
  purities      Purity[] 
  grades        Grade[]
  designs       Design[]
  products      Product[]
  items         Item[]
  stones        Stone[]
  employees     Employee[]
  partytypes     Partytype[]
  partymasters   Partymaster[]
  partyOpeningBalance PartyOpeningBalance[]
}

model Brand {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  
  storeId     Int
  store       Store   @relation(fields: [storeId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  storeId     Int
  store       Store   @relation(fields: [storeId], references: [id])
  products    Product[]
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model Metal {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  storeId     Int
  store       Store   @relation(fields: [storeId], references: [id])
  purities    Purity[] 
  products    Product[]
  partyOpeningBalance PartyOpeningBalance[]
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Purity {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  metalId     Int
  metal       Metal   @relation(fields: [metalId], references: [id])

  storeId     Int
  
  store       Store   @relation(fields: [storeId], references: [id])
  
  grades      Grade[] 

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
}

model Grade {
  id          Int      @id @default(autoincrement())
  name        String
  percentage  Float
  description String?

  purityId    Int
  purity      Purity  @relation(fields: [purityId], references: [id])

  storeId     Int
  store       Store   @relation(fields: [storeId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Design {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  image       String? 
  storeId     Int
  store       Store   @relation(fields: [storeId], references: [id])
  items   Item[]
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id          Int      @id @default(autoincrement())
  productCode String   @unique
  name        String
  image       String?
  description String?

  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])

  metalId     Int
  metal       Metal    @relation(fields: [metalId], references: [id])

  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id])

  items   Item[]
  stones  Stone[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Item {
  id          Int      @id @default(autoincrement())
  itemCode    String   @unique
  name        String
  image       String?
  description String?

  productId   Int
  product     Product  @relation(fields: [productId], references: [id])

  designId    Int
  design      Design   @relation(fields: [designId], references: [id])

  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id])

  stones      Stone[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Stone {
  id          Int      @id @default(autoincrement())
  name        String
  description String?

  productId   Int
  product     Product  @relation(fields: [productId], references: [id])

  itemId      Int
  item        Item     @relation(fields: [itemId], references: [id])

  storeId     Int
  store       Store    @relation(fields: [storeId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Employee {
  id          Int      @id @default(autoincrement())
  empCode     String   @unique
  name        String
  mobile      String
  email       String   @unique
  salary      Float

  storeId     Int
  store        Store    @relation(fields: [storeId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Partytype {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  
  storeId     Int
  store       Store   @relation(fields: [storeId], references: [id])
  partymaster Partymaster[]
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Partymaster {
  id          Int     @id @default(autoincrement())
  name        String
  gst         String?
  phone       String? 
  storeId     Int
  partytypeId Int
  store       Store   @relation(fields: [storeId], references: [id])
  partytype   Partytype     @relation(fields: [partytypeId], references: [id])
  partyOpeningBalance PartyOpeningBalance[]
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PartyOpeningBalance {
  id          Int     @id @default(autoincrement())
  debit       Int?
  credit      Int?
  type        String
  year        String
  storeId     Int
  partymasterId Int
  metalId     Int
  store       Store   @relation(fields: [storeId], references: [id])
  partymaster   Partymaster     @relation(fields: [partymasterId], references: [id])
   metal       Metal   @relation(fields: [metalId], references: [id])

  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}